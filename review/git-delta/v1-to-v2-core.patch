+    for members in groups.values():
+        reference = candidates[members[0]][1]
+        unwrapped = []
+        for member in members:
+            xy = candidates[member][1]
+            delta = xy - reference
+            delta -= box_xy_A * np.round(delta / box_xy_A)
+            unwrapped.append(reference + delta)
