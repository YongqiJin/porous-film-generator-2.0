+        loss = math.inf
+    else:
+        weights = np.maximum(target[valid], 1.0e-12)
+        loss = float(np.average((observed[valid] - target[valid]) ** 2, weights=weights))
+    return {
+        "passed": bool(loss <= _V3_RDF_LOSS_LIMIT),
+        "weighted_loss": loss,
+        "pair_count": pair_count,
